# RelayDesk Environment Configuration
# Reference only: this application does not automatically load .env files.
# Set RELAYDESK_DATA_DIR in your shell before starting the server.

# Data directory for SQLite database (default: ./data)
# RELAYDESK_DATA_DIR=./data

# run_server.py listens on 127.0.0.1:8000.
# To change the port, use python -m uvicorn backend.main:app --host 127.0.0.1 --port 8001.
