# Copy to .env and fill in real values. Never commit .env.

# --- seekdb / OceanBase (MySQL protocol) ---
SPECANCHOR_DB_HOST=127.0.0.1
SPECANCHOR_DB_PORT=2881
SPECANCHOR_DB_USER=root
SPECANCHOR_DB_PASSWORD=
SPECANCHOR_DB_NAME=specanchor

# --- paths ---
# Defaults resolve relative to the minimax/ directory.
SPECANCHOR_PROJECT_ROOT=./sample_project
SPECANCHOR_STATE_DIR=./.state

# --- MiniMax (required only for `specanchor apply`) ---
# Token Plan key from https://platform.minimax.cn/ ; keep it in .env only.
MINIMAX_API_KEY=sk-replace-me
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_MODEL=MiniMax-M3.1-Flash
MINIMAX_REASONING_EFFORT=high
